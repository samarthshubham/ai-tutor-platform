# Local-only credentials for the dev stack; the compose file uses these values by default.
# Copy to infra/.env to change them. tutor-api reads TUTOR_DB_PASSWORD too.
TUTOR_DB_PASSWORD=tutor
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Only for the `cloud` AI profile; never commit a real key.
ANTHROPIC_API_KEY=
