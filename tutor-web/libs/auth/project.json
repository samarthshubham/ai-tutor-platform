{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/src",
  "prefix": "tp",
  "projectType": "library",
  "tags": ["type:lib", "scope:auth"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/auth/ng-package.json",
        "tsConfig": "libs/auth/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/auth/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "coverage": true,
        "coverageInclude": ["libs/auth/src/**/*.ts"],
        "coverageExclude": ["**/*.spec.ts", "**/index.ts"],
        "coverageReporters": ["lcov", "text-summary"],
        "coverageThresholds": { "statements": 90, "lines": 90, "branches": 80 }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
